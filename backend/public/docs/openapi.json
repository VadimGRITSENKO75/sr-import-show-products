{
    "openapi": "3.1.0",
    "info": {
        "title": "Import/Export Products API",
        "description": "API для импорта и управления товарами",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Local dev server"
        }
    ],
    "paths": {
        "/api/import": {
            "post": {
                "summary": "Загрузить xlsx для импорта",
                "operationId": "6cdc83e8ca8ebe3969c82189f3589db7",
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Задача создана",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "taskId": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Ошибка валидации"
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Список товаров с пагинацией и фильтрацией",
                "operationId": "992f76b404f4e2f60a400b246db4e558",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Номер страницы (начиная с 1)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Количество товаров на странице (макс. 100)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 20
                        }
                    },
                    {
                        "name": "name",
                        "in": "query",
                        "description": "Поиск по названию (частичное совпадение)",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "price_min",
                        "in": "query",
                        "description": "Минимальная цена",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    },
                    {
                        "name": "price_max",
                        "in": "query",
                        "description": "Максимальная цена",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Постраничный список товаров",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "externalCode": {
                                                        "type": "string",
                                                        "example": "SKU-001"
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Тестовый товар"
                                                    },
                                                    "price": {
                                                        "type": "string",
                                                        "example": "1000.00"
                                                    },
                                                    "discount": {
                                                        "type": "string",
                                                        "example": "15.00"
                                                    }
                                                }
                                            }
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 42
                                        },
                                        "page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "limit": {
                                            "type": "integer",
                                            "example": 20
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products/{id}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Карточка товара с атрибутами и изображениями",
                "operationId": "915e7058fea0536e645a854d66ccc27c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID товара",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Полная информация о товаре",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "externalCode": {
                                            "type": "string",
                                            "example": "SKU-001"
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "Тестовый товар"
                                        },
                                        "description": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "example": "Описание"
                                        },
                                        "price": {
                                            "type": "string",
                                            "example": "1000.00"
                                        },
                                        "discount": {
                                            "type": "string",
                                            "example": "15.00"
                                        },
                                        "attributes": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "key": {
                                                        "type": "string",
                                                        "example": "Доп. поле: Цвет"
                                                    },
                                                    "value": {
                                                        "type": "string",
                                                        "example": "Красный"
                                                    }
                                                }
                                            }
                                        },
                                        "images": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "url": {
                                                        "type": "string",
                                                        "example": "https://example.com/img.jpg"
                                                    },
                                                    "path": {
                                                        "type": "string",
                                                        "example": "/uploads/img_123.jpg"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Товар не найден",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Product not found"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Products",
            "description": "Products"
        }
    ]
}